{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "nws-weather-mcp-server",
  "version": "0.9.5",
  "description": "Get US weather forecasts, active alerts, and current observations via the National Weather Service API. STDIO or Streamable HTTP.",
  "author": {
    "name": "Casey Hand",
    "email": "casey@caseyjhand.com",
    "url": "https://caseyjhand.com"
  },
  "homepage": "https://github.com/cyanheads/nws-weather-mcp-server#readme",
  "repository": "https://github.com/cyanheads/nws-weather-mcp-server",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "weather",
    "nws",
    "national-weather-service",
    "forecast",
    "alerts",
    "observations",
    "typescript",
    "bun",
    "stdio",
    "streamable-http"
  ],
  "userConfig": {
    "nws_user_agent": {
      "type": "string",
      "title": "NWS User Agent",
      "description": "User-Agent header for NWS API requests. The API requires this header but a default is provided.",
      "required": false,
      "default": ""
    }
  },
  "mcpServers": {
    "nws-weather-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/nws-weather-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "NWS_USER_AGENT": "${user_config.nws_user_agent}"
      }
    }
  }
}
