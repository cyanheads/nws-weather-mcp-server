# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=localhost           # HTTP host (default: localhost)
# MCP_HTTP_ENDPOINT_PATH=/mcp      # HTTP endpoint path (default: /mcp)
# MCP_PUBLIC_URL=                  # Public origin behind a TLS-terminating proxy (e.g. https://mcp.example.com)

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER_TYPE=in-memory   # in-memory | filesystem | supabase | cloudflare-r2 | cloudflare-kv | cloudflare-d1

# ── Session ──────────────────────────────────────────────────────────
# stateful | stateless | auto (default: auto, which resolves to stateful).
# This server is stateless: no tool requests user input mid-call, so it needs
# nothing from the session-bound legacy input shim. The Dockerfile sets the same
# value, so a container and a source run resolve identically.
MCP_SESSION_MODE=stateless
# MCP_HTTP_RESUMABILITY=false       # SSE replay on a dropped stateful stream. Default: true.
                                    # Kill switch only — no effect under stateless.
# MCP_HTTP_RESUMABILITY_MAX_EVENTS=512   # Retained per session, oldest evicted first (stateful only)
# MCP_HTTP_RESUMABILITY_TTL_MS=300000    # How long a retained event stays replayable (stateful only)

# ── Logging ───────────────────────────────────────────────────────────
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error
# MCP_LOG_RATE_LIMIT_THRESHOLD=10   # Max emissions per level+message per window; 0 disables
# MCP_LOG_RATE_LIMIT_WINDOW_MS=60000

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=               # OTLP endpoint URL (e.g., http://localhost:4318)

# ── Performance ───────────────────────────────────────────────────────
# MCP_GC_PRESSURE_INTERVAL_MS=0      # Forced GC interval in ms (Bun HTTP only, 0 = disabled). Recommended for HTTP deployments exhibiting heap growth: 60000
# MCP_HTTP_MAX_BODY_BYTES=1048576    # Inbound request body cap in bytes (default: 1 MiB). Set to 0 to disable.

# ── NWS API ──────────────────────────────────────────────────────────
# NWS_USER_AGENT=(nws-weather-mcp-server, github.com/cyanheads/nws-weather-mcp-server)
